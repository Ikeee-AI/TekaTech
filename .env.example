# Settings for `docker compose up` (docker-compose.yml). Copy this file to .env in the
# same folder and fill in the values you were given. .env is gitignored: never commit it,
# never share it publicly. Guide: docs/docker.md
#
# For judges: the TekaTech team sends you a filled-in .env privately. It points at the
# team's DEV database (not production) and a separate OpenAI key with a small spending cap.

# OpenAI key for embeddings and AI answers (sk-...).
OPENAI_API_KEY=

# Supabase project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=

# Supabase SECRET / service-role key (sb_secret_...). Used only by the api container.
# It bypasses Row Level Security, so treat it like a password.
SUPABASE_SECRET_KEY=

# Supabase PUBLISHABLE / anon key (sb_publishable_...). Public; built into the web app.
SUPABASE_PUBLISHABLE_KEY=

# Optional: change the ports if 8080 or 8000 is already used on your computer.
# WEB_PORT=8080
# API_PORT=8000

# Optional: per-user daily AI caps (defaults shown).
# AI_DAILY_QUESTION_LIMIT=20
# AI_DAILY_WEB_SEARCH_LIMIT=5
# WEB_SEARCH_SITE_DAILY_LIMIT=40
