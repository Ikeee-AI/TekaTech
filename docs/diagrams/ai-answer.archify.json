  "cards": [
    {
      "dot": "emerald",
      "title": "Grounded first (RAG)",
      "items": [
        "Every question is answered from saved specs first: embed, pgvector match, numbered snippets",
        "Scoped questions take the nearest chunks for the asked phones; game or fps questions add sourced benchmark rows",
        "The backend strips citations to snippets that were not sent and drops a base model's values after a declined variant"
      ]
    },
    {
      "dot": "amber",
      "title": "General Knowledge and web search",
      "items": [
        "Both are off by default; the user turns them on per question",
        "Only a reply with none of the answer falls back; a partial answer stays grounded and cited",
        "Web answers cite the pages found; when the web cap is used up or search fails, General Knowledge answers if it is on",
        "Fallback answers are labelled as not from the saved specs"
      ]
    },
    {
      "dot": "rose",
      "title": "Failures",
      "items": [
        "Not signed in, invalid body or over a limit: plain JSON error before streaming",
        "Provider error, timeout or a cut-off answer: SSE error with a readable 503, never a partial answer"
      ]
    }
  ]
