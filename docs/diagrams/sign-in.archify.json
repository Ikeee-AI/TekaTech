  "cards": [
    {
      "dot": "rose",
      "title": "Route code is the only access control",
      "items": [
        "The backend uses the service-role key, which bypasses Row Level Security",
        "get_current_user guards signed-in routes; get_current_admin_user also needs app_metadata.is_admin, which only the admin API can set"
      ]
    },
