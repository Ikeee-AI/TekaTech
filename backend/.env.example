# Copy to .env and fill in. The real .env is gitignored.

# OpenAI — used for spec-chunk embeddings and Q&A/comparison answers
openai_api_key=sk-...

# Supabase project URL
supabase_url=https://your-project-ref.supabase.co

# Supabase SECRET / service-role key (sb_secret_...), NOT the publishable one.
# This backend needs admin-level DB access and sets admin flags via the auth
# admin API. Note this key bypasses Row Level Security entirely — the FastAPI
# route dependencies are the only access control.
supabase_key=sb_secret_...

# Comma-separated list of allowed browser origins for CORS.
# Optional; defaults to http://localhost:5173 when unset.
# Add your deployed frontend origin here before deploying.
cors_origins=http://localhost:5173

# Where rate-limit counters are stored.
# Optional; defaults to memory:// when unset.
#
# memory://  = per-process counters. Correct ONLY for a single worker. With N
#              workers/replicas each keeps its own counters, so the effective
#              limit becomes N x the configured value.
# redis://   = shared counters across processes. Required for any multi-worker
#              or multi-replica deploy. Use rediss:// for TLS.
#
# A configured store that is unreachable at boot aborts startup rather than
# silently falling back to per-process limits.
rate_limit_storage_uri=memory://

# Failure drill for POST /query: lets a logged-in ADMIN send an X-Simulate-Failure header
# (timeout | quota | bad_output | empty) to see the safe error responses without calling
# OpenAI. Optional; defaults to false. Use it on a dev machine only, never in production.
failure_simulation_enabled=false
