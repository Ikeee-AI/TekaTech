# Copy to .env and fill in. The real .env is gitignored.
# Everything here ships to the browser — only ever put public keys in this file.

# Supabase project URL (same project as the backend)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase PUBLISHABLE / anon key (sb_publishable_...), NOT the secret one.
# Used for auth only — all data access goes through the FastAPI backend.
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Origin of the FastAPI backend.
# Optional; defaults to http://127.0.0.1:8000 when unset.
# Set this to the deployed backend's URL when building for production, and make
# sure this frontend's own origin is listed in the backend's cors_origins.
VITE_API_BASE_URL=http://127.0.0.1:8000
